#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

mix tai.gen.migration
mix format --check-formatted
CI=true mix test
mix dialyzer

cd packages/stored
mix format --check-formatted
CI=true mix test

cd ../tai_events
mix format --check-formatted
CI=true mix test
